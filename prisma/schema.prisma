// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dateOfBirth DateTime?
  address   String?
  phone     String?
  emergencyContact String?
  emergencyPhone String?

  // Relations
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  
  // For operators - who manages them
  managedById String?
  managedBy   User?   @relation("UserManagement", fields: [managedById], references: [id])
  managedUsers User[] @relation("UserManagement")
  
  // For operators - what type (office/police)
  operatorType OperatorType?
  
  // Created entities
  createdBranches Branch[]
  createdAlarms   Alarm[]
  createdReports  AlarmReport[]
  
  // Assigned branches (for operators)
  // assignedBranches BranchOperator[]

  @@map("users")
  CompanyOperator CompanyOperator[]
  acknowledgedAlarmReports AlarmReport[] @relation("AcknowledgedBy")
  resolvedAlarmReports AlarmReport[] @relation("ResolvedBy")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?  
  type        String?  
  industry    String?  
  address     String?  
  city        String?  
  country     String?  @default("Ethiopia") // ✅ Optional
  phone       String? 
  email       String? 
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  branches    Branch[]

  @@map("companies")
  CompanyOperator CompanyOperator[]
  Alarm Alarm[]
}


model Branch {
  id          String   @id @default(cuid())
  name        String
  locationType String
  gpsAddress  String?
  latitude   String?
  longitude String?
  city        String
  subCity     String?
  woreda      String?
  country     String   @default("Ethiopia")
  managerName String
  phoneNumber String
  contactNumber1 String?
  contactNumber2 String?
  description String?
  status      BranchStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyName    String?   // <- required
  logo           String?  // <- optional


  // Relations
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  
  // Assigned operators
  // operators BranchOperator[]
  alarms    Alarm[]

  @@map("branches")
}

model CompanyOperator {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String

  operator   User     @relation(fields: [operatorId], references: [id])
  operatorId String

  assignedAt DateTime @default(now())

  @@unique([companyId, operatorId]) // optional: avoid duplicate entries
}

