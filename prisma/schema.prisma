model Alarm {
  id          String   @id @default(cuid())
  type        String
  location    String?
  longitude    String?
  latitude    String?
  severity    AlarmSeverity
  description String
  additionalNotes String?
  status      AlarmStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Relations
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  
  // Police response
  reports AlarmReport[]

  @@map("alarms")
}

model AlarmReport {
  id          String   @id @default(cuid())
  status      ReportStatus @default(PENDING)
  acknowledgedAt DateTime?
  completedAt    DateTime?
  resolutionDescription String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyName   String?
  companyLogo   String?

  branchName  String?
  branchlocationType  String?
  branchgpsAddress  String?
  branchcity String?
  branchsubCity String?
  branchworeda String?
  branchcountry String?
  branchmanagerName String?
  branchphoneNumber String?
  branchcontactNumber1 String?

  // Relations
  alarmId String
  alarm   Alarm  @relation(fields: [alarmId], references: [id])
  
  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  acknowledgedById String?      
  acknowledgedBy   User?        @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])

  resolvedById     String?      
  resolvedBy       User?        @relation("ResolvedBy", fields: [resolvedById], references: [id])

  @@map("alarm_reports")
}

// Enums
enum Role {
  SUPER_ADMIN
  OFFICE_MANAGER
  POLICE_MANAGER
  OPERATOR
}

enum OperatorType {
  OFFICE
  POLICE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AlarmSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlarmStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum ReportStatus {
  PENDING
  ACKNOWLEDGED
  COMPLETED
}
