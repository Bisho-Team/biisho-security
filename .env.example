# Used by the root docker-compose.yml. Copy to .env and fill in.
# api/.env and client/.env are only for running the apps directly on the host.

# Postgres (avoid URL-special characters like @ : / in the password; it is embedded in DATABASE_URL)
POSTGRES_DB=koppa_security_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# API
API_PORT=3001
WS_PORT=3002
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
# Password for the accounts created by api/prisma/seed.ts
SEED_PASSWORD=change-me

# Client (NEXT_PUBLIC_* are baked in at build time; rebuild after changing)
CLIENT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3002
