# Used when running the API directly on the host (npm run dev).
# Docker settings live in the root .env.

# Database (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/koppa_security_db"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Server
PORT=3001
NODE_ENV="development"

WS_PORT=3002
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# CORS
FRONTEND_URL="http://localhost:3000"

# Password for the accounts created by prisma/seed.ts (npm run db:seed)
SEED_PASSWORD=change-me
